HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/demo.sqlite
# Define valores distintos y privados para habilitar los perfiles privilegiados.
DEMO_STAFF_PIN=
DEMO_STAFF_2_PIN=
DEMO_ORGANIZER_PIN=
# Necesario para npm run db:reset. Mantener deshabilitado durante el uso normal.
ALLOW_DEMO_RESET=false

# Triaje H7. Solo relatos ficticios de la demo.
TRIAGE_ENABLED=false
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
TRIAGE_TIMEOUT_MS=5000
TRIAGE_MAX_QUEUE_AGE_MS=30000
TRIAGE_DAILY_LIMIT=100
OPENAI_CHAT_MODEL=gpt-6.1-sol
CHAT_AI_TIMEOUT_MS=15000
CHAT_AI_MAX_ZONES=16
