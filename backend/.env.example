HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/demo.sqlite
# Define valores distintos y privados para habilitar los perfiles privilegiados.
DEMO_STAFF_PIN=
DEMO_STAFF_2_PIN=
DEMO_ORGANIZER_PIN=
# Necesario para npm run db:reset. Mantener deshabilitado durante el uso normal.
ALLOW_DEMO_RESET=false
DEMO_PURGE_ENABLED=false

# Triaje H7. Solo relatos ficticios de la demo.
TRIAGE_ENABLED=false
CHAT_AI_ENABLED=false
FIRST_AID_ENABLED=true
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
TRIAGE_TIMEOUT_MS=5000
TRIAGE_MAX_QUEUE_AGE_MS=30000
TRIAGE_DAILY_LIMIT=100
OPENAI_CHAT_MODEL=gpt-6.1-sol
CHAT_AI_TIMEOUT_MS=30000
CHAT_AI_DAILY_LIMIT=100
CHAT_AI_MAX_QUEUE_AGE_MS=30000
CHAT_AI_MAX_ZONES=64
CHAT_AI_CONTEXT_BYTES=32768
CHAT_AI_RECENT_MESSAGES=16
CHAT_AI_MAX_OUTPUT_TOKENS=2560
CHAT_AI_MAX_INCIDENT_CALLS=60
CHAT_AI_DIAGNOSTICS=false

DISPATCH_EARLY_SECONDS=120
DISPATCH_LATE_SECONDS=300
